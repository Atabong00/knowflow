# ==========================================
# KnowFlow - Environment Configuration
# ==========================================

# Application
PROJECT_NAME=KnowFlow
DEBUG=false
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
APP_BASE_URL=http://localhost:8000

# PostgreSQL
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_MULTIPLE_DATABASES=knowflow_db,keycloak_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://knowflow:CHANGE_ME@db:5432/knowflow_db

# Keycloak / OIDC
KEYCLOAK_SERVER_URL=http://localhost:8082
KEYCLOAK_BACKEND_URL=http://keycloak:8080
KEYCLOAK_REALM=employee-portal
KEYCLOAK_CLIENT_ID=wiki-app
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# Keycloak Administration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Application Test / Seed Users
ADMIN_PASSWORD=CHANGE_ME
EDITOR_PASSWORD=CHANGE_ME
EMPLOYEE_PASSWORD=CHANGE_ME

# Keycloak Hostname
KC_HOSTNAME=localhost
